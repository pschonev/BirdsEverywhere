{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://birdseverywhere.invalid/schemas/bird.schema.json",
    "title": "Bird definition",
    "type": "object",
    "required": [
        "id",
        "name",
        "scName"
    ],
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "minLength": 1
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "scName": {
            "type": "string",
            "minLength": 1
        },
        "shorthand": {
            "type": "string",
            "minLength": 1
        },
        "template": {
            "type": "string",
            "minLength": 1
        },
        "defaults": {
            "$ref": "rule.schema.json"
        },
        "rules": {
            "type": "object",
            "additionalProperties": {
                "$ref": "rule.schema.json"
            }
        }
    }
}