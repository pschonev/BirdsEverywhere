{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://birding.invalid/schemas/rule.schema.json",
    "title": "Spawn rule or defaults",
    "description": "Every field is optional here: bird and template files are merged by TemplateMerger before ContentValidator checks that required fields are present.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "bridgeFixed": {
                    "type": "boolean"
                },
                "seasons": {
                    "type": "array",
                    "items": {
                        "enum": [
                            "spring",
                            "summer",
                            "fall",
                            "winter",
                            "Spring",
                            "Summer",
                            "Fall",
                            "Winter"
                        ]
                    }
                },
                "weather": {
                    "type": "array",
                    "items": {
                        "enum": [
                            "sun",
                            "rain",
                            "storm",
                            "snow",
                            "wind",
                            "greenrain",
                            "greenRain",
                            "Sun",
                            "Rain",
                            "Storm",
                            "Snow",
                            "Wind",
                            "GreenRain",
                            "any",
                            "clear",
                            "precipitation"
                        ]
                    }
                },
                "days": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/range",
                        "items": {
                            "minimum": 1,
                            "maximum": 28
                        }
                    }
                },
                "times": {
                    "type": "array",
                    "items": {
                        "$ref": "common.schema.json#/$defs/timeRange"
                    }
                },
                "any": {
                    "description": "Alternative clauses; the condition holds when any clause matches. Cannot be combined with the other keys.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "seasons": {
                                "$ref": "#/properties/when/properties/seasons"
                            },
                            "weather": {
                                "$ref": "#/properties/when/properties/weather"
                            },
                            "days": {
                                "$ref": "#/properties/when/properties/days"
                            },
                            "times": {
                                "$ref": "#/properties/when/properties/times"
                            },
                            "bridgeFixed": {
                                "$ref": "#/properties/when/properties/bridgeFixed"
                            }
                        }
                    }
                }
            }
        },
        "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "spawnPattern": {
            "enum": [
                "GroundSpawner",
                "WaterSpawner",
                "WaterOrGroundSpawner",
                "SpawnableGroundSpawner",
                "TreeTrunkSpawner",
                "BushSpawner"
            ]
        },
        "birdType": {
            "enum": [
                "LandBird",
                "WaterLandBird",
                "TreeTrunkBird",
                "BushBird"
            ]
        },
        "groupCount": {
            "$ref": "#/$defs/range",
            "items": {
                "minimum": 1
            }
        },
        "groupSize": {
            "$ref": "#/$defs/range",
            "items": {
                "minimum": 1
            }
        },
        "textures": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "integer",
                "minimum": 1
            }
        },
        "weight": {
            "type": "number",
            "exclusiveMinimum": 0
        },
        "spawnParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "shoreDistance": {
                    "$ref": "#/$defs/range",
                    "items": {
                        "minimum": 0,
                        "maximum": 20
                    }
                },
                "group": {
                    "description": "Tile patterns only. How each group's members are laid out around its first tile; missing: the legacy random walk.",
                    "type": "object",
                    "required": [
                        "formation"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "formation": {
                            "description": "cluster: dense around the first tile; scattered: spread evenly within the radius; line: a straight row.",
                            "enum": [
                                "cluster",
                                "scattered",
                                "line"
                            ]
                        },
                        "radius": {
                            "description": "Tiles from the first tile, default 3.",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 15
                        },
                        "spacing": {
                            "description": "Minimum tiles between members, default 1.",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 5
                        },
                        "groupSpacing": {
                            "description": "Minimum tiles between the groups of this rule, default 0.",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 40
                        },
                        "members": {
                            "type": "object",
                            "minProperties": 1,
                            "additionalProperties": {
                                "type": "object",
                                "required": [
                                    "count",
                                    "stage"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                    "count": {
                                        "description": "[min, max]; a role that is not required may have min 0.",
                                        "$ref": "#/$defs/range",
                                        "items": {
                                            "minimum": 0
                                        }
                                    },
                                    "stage": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "required": {
                                        "description": "Placed first; the group is dropped when this role cannot be placed.",
                                        "type": "boolean"
                                    },
                                    "textures": {
                                        "$ref": "common.schema.json#/$defs/weightMap"
                                    }
                                }
                            }
                        }
                    }
                },
                "speciesDistance": {
                    "description": "Minimum tiles to birds of other species already planned here, default 8.",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 40
                }
            }
        },
        "routine": {
            "description": "Shared routine id (assets/routines/<id>.json) or an inline routine. Missing: the bird type's default routine.",
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 1
                },
                {
                    "$ref": "routine.schema.json"
                }
            ]
        },
        "sounds": {
            "description": "Sound role to a vanilla cue or 'audio:<name>' for assets/audio/<name>.ogg|.wav; merged over the bird type's defaults. \"\" silences a role.",
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "soundCooldownMs": {
            "description": "Minimum ms between two plays of a sound role on the same bird.",
            "type": "object",
            "additionalProperties": {
                "type": "integer",
                "minimum": 0
            }
        },
        "reactions": {
            "description": "Shared reactions id (assets/reactions) or inline reactions object.",
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 1
                },
                {
                    "$ref": "reaction.schema.json"
                }
            ]
        },
        "actions": {
            "description": "Per-field overrides of the bird type's action set (assets/actions), keyed by action id. New ids on routine-driven bird types (Land, WaterLand) define custom 'stay' actions with a clip that the routine can pick.",
            "type": "object",
            "additionalProperties": {
                "$ref": "action.schema.json#/$defs/partialAction"
            }
        },
        "stages": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "layout": {
                        "type": "string",
                        "minLength": 1
                    },
                    "routine": {
                        "oneOf": [
                            {
                                "$ref": "#/properties/routine"
                            },
                            {
                                "type": "object",
                                "required": [
                                    "extends"
                                ],
                                "properties": {
                                    "extends": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "chance": {
                                        "$ref": "routine.schema.json#/properties/chance"
                                    },
                                    "pick": {
                                        "$ref": "routine.schema.json#/properties/pick"
                                    },
                                    "next": {
                                        "$ref": "routine.schema.json#/properties/next"
                                    },
                                    "rare": {
                                        "$ref": "routine.schema.json#/properties/rare"
                                    }
                                },
                                "additionalProperties": false
                            }
                        ]
                    },
                    "reactions": {
                        "$ref": "#/properties/reactions"
                    },
                    "actions": {
                        "$ref": "#/properties/actions"
                    },
                    "sounds": {
                        "$ref": "#/properties/sounds"
                    }
                }
            }
        }
    },
    "$defs": {
        "range": {
            "$ref": "common.schema.json#/$defs/range"
        }
    }
}