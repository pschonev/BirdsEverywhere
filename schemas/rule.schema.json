{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://birdseverywhere.invalid/schemas/rule.schema.json",
    "title": "Spawn rule or defaults",
    "description": "Every field is optional here: bird and template files are merged by TemplateMerger before ContentValidator checks that required fields are present.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "seasons": {
                    "type": "array",
                    "items": {
                        "enum": [
                            "spring",
                            "summer",
                            "fall",
                            "winter",
                            "Spring",
                            "Summer",
                            "Fall",
                            "Winter"
                        ]
                    }
                },
                "weather": {
                    "type": "array",
                    "items": {
                        "enum": [
                            "sun",
                            "rain",
                            "storm",
                            "snow",
                            "wind",
                            "greenrain",
                            "Sun",
                            "Rain",
                            "Storm",
                            "Snow",
                            "Wind",
                            "GreenRain"
                        ]
                    }
                },
                "days": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/range",
                        "items": {
                            "minimum": 1,
                            "maximum": 28
                        }
                    }
                },
                "times": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/range",
                        "items": {
                            "minimum": 600,
                            "maximum": 2600
                        }
                    }
                }
            }
        },
        "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "spawnPattern": {
            "enum": [
                "GroundSpawner",
                "WaterSpawner",
                "WaterOrGroundSpawner",
                "SpawnableGroundSpawner",
                "TreeTrunkSpawner",
                "BushSpawner"
            ]
        },
        "birdType": {
            "enum": [
                "LandBird",
                "WaterLandBird",
                "TreeTrunkBird",
                "BushBird"
            ]
        },
        "groupCount": {
            "$ref": "#/$defs/range",
            "items": {
                "minimum": 1
            }
        },
        "groupSize": {
            "$ref": "#/$defs/range",
            "items": {
                "minimum": 1
            }
        },
        "textures": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "integer",
                "minimum": 1
            }
        },
        "weight": {
            "type": "number",
            "exclusiveMinimum": 0
        },
        "spawnParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "shoreDistance": {
                    "$ref": "#/$defs/range",
                    "items": {
                        "minimum": 0,
                        "maximum": 20
                    }
                },
                "group": {
                    "description": "Tile patterns only. How each group's members are laid out around its first tile; missing: the legacy random walk.",
                    "type": "object",
                    "required": [
                        "formation"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "formation": {
                            "description": "cluster: dense around the first tile; scattered: spread evenly within the radius; line: a straight row.",
                            "enum": [
                                "cluster",
                                "scattered",
                                "line"
                            ]
                        },
                        "radius": {
                            "description": "Tiles from the first tile, default 3.",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 15
                        },
                        "spacing": {
                            "description": "Minimum tiles between members, default 1.",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 5
                        },
                        "groupSpacing": {
                            "description": "Minimum tiles between the groups of this rule, default 0.",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 40
                        }
                    }
                },
                "speciesDistance": {
                    "description": "Minimum tiles to birds of other species already planned here, default 8.",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 40
                }
            }
        },
        "routine": {
            "description": "Shared routine id (assets/routines/<id>.json) or an inline routine. Missing: the bird type's default routine.",
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 1
                },
                {
                    "$ref": "routine.schema.json"
                }
            ]
        },
        "sounds": {
            "description": "Sound role to a vanilla cue or 'audio:<name>' for assets/audio/<name>.ogg|.wav; merged over the bird type's defaults. \"\" silences a role.",
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "soundCooldownMs": {
            "description": "Minimum ms between two plays of a sound role on the same bird.",
            "type": "object",
            "additionalProperties": {
                "type": "integer",
                "minimum": 0
            }
        },
        "reactions": {
            "description": "Shared reactions id (assets/reactions) or inline reactions object.",
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 1
                },
                {
                    "$ref": "reaction.schema.json"
                }
            ]
        },
        "actions": {
            "description": "Per-field overrides of the bird type's action set (assets/actions), keyed by action id. New ids on routine-driven bird types (Land, WaterLand) define custom 'stay' actions with a clip that the routine can pick.",
            "type": "object",
            "additionalProperties": {
                "$ref": "action.schema.json#/$defs/partialAction"
            }
        }
    },
    "$defs": {
        "range": {
            "$ref": "common.schema.json#/$defs/range"
        }
    }
}