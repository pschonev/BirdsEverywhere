{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://birdseverywhere.invalid/schemas/rule.schema.json",
    "title": "Spawn rule or defaults",
    "description": "Every field is optional here: bird and template files are merged by TemplateMerger before ContentValidator checks that required fields are present.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "seasons": {
                    "type": "array",
                    "items": {
                        "enum": [
                            "spring",
                            "summer",
                            "fall",
                            "winter",
                            "Spring",
                            "Summer",
                            "Fall",
                            "Winter"
                        ]
                    }
                },
                "weather": {
                    "type": "array",
                    "items": {
                        "enum": [
                            "sun",
                            "rain",
                            "storm",
                            "snow",
                            "wind",
                            "greenrain",
                            "Sun",
                            "Rain",
                            "Storm",
                            "Snow",
                            "Wind",
                            "GreenRain"
                        ]
                    }
                },
                "days": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/range",
                        "items": {
                            "minimum": 1,
                            "maximum": 28
                        }
                    }
                },
                "times": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/range",
                        "items": {
                            "minimum": 600,
                            "maximum": 2600
                        }
                    }
                }
            }
        },
        "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "spawnPattern": {
            "enum": [
                "GroundSpawner",
                "WaterSpawner",
                "WaterOrGroundSpawner",
                "SpawnableGroundSpawner",
                "TreeTrunkSpawner",
                "BushSpawner"
            ]
        },
        "birdType": {
            "enum": [
                "LandBird",
                "WaterLandBird",
                "TreeTrunkBird",
                "BushBird"
            ]
        },
        "groupCount": {
            "$ref": "#/$defs/range",
            "items": {
                "minimum": 1
            }
        },
        "groupSize": {
            "$ref": "#/$defs/range",
            "items": {
                "minimum": 1
            }
        },
        "textures": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "integer",
                "minimum": 1
            }
        },
        "weight": {
            "type": "number",
            "exclusiveMinimum": 0
        },
        "spawnParams": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "shoreDistance": {
                    "$ref": "#/$defs/range",
                    "items": {
                        "minimum": 0,
                        "maximum": 20
                    }
                }
            }
        },
        "routine": {
            "description": "Shared routine id (assets/routines/<id>.json) or an inline routine. Missing: the bird type's default routine.",
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 1
                },
                {
                    "$ref": "routine.schema.json"
                }
            ]
        },
        "sounds": {
            "description": "Sound role to vanilla or mod cue; merged over the bird type's defaults. \"\" silences a role.",
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        }
    },
    "$defs": {
        "range": {
            "$ref": "common.schema.json#/$defs/range"
        }
    }
}