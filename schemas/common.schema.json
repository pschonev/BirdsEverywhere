{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://birding.invalid/schemas/common.schema.json",
    "title": "Shared definitions",
    "$defs": {
        "weightMap": {
            "description": "Ids to positive integer weights.",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "integer",
                "minimum": 1
            }
        },
        "timeBound": {
            "description": "HHMM clock time (600-2600) or an anchor with optional minute offset: sunrise, dusk, dark, e.g. sunrise+120.",
            "oneOf": [
                {
                    "type": "integer",
                    "minimum": 600,
                    "maximum": 2600
                },
                {
                    "type": "string",
                    "pattern": "^(sunrise|dusk|dark)([+-][0-9]{1,3})?$"
                }
            ]
        },
        "timeRange": {
            "description": "Inclusive [from, to] of time bounds.",
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
                "$ref": "#/$defs/timeBound"
            }
        },
        "range": {
            "description": "Inclusive [min, max].",
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
                "type": "integer"
            }
        },
        "stepRange": {
            "description": "Inclusive [min, max] or [min, max, step], rolled as Next(min / step, max / step + 1) * step.",
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "prefixItems": [
                {
                    "type": "integer",
                    "minimum": 0
                },
                {
                    "type": "integer",
                    "minimum": 0
                },
                {
                    "type": "integer",
                    "minimum": 1
                }
            ]
        },
        "intOrStepRange": {
            "oneOf": [
                {
                    "type": "integer",
                    "minimum": 0
                },
                {
                    "$ref": "#/$defs/stepRange"
                }
            ]
        }
    }
}