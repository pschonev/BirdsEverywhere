{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://birdseverywhere.invalid/schemas/regions.schema.json",
    "title": "Regions",
    "type": "object",
    "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "ratio": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
            },
            "species": {
                "$ref": "#/$defs/species"
            },
            "groups": {
                "$ref": "#/$defs/groups"
            }
        }
    },
    "$defs": {
        "species": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "groups": {
            "type": "object",
            "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "string",
                    "pattern": "^[^@\\s]"
                }
            }
        }
    }
}