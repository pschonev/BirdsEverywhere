{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://birding.invalid/schemas/reaction.schema.json",
    "title": "Reactions",
    "description": "How a bird reacts to triggers. Missing fields keep the bird type's default (flee radius: land and water-land 4, tree trunk 6). Bush birds take no reactions.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "threat": {
            "oneOf": [
                {
                    "$ref": "#/$defs/legacyThreat"
                },
                {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": [
                            "flee"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "if": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "groupHasRole": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "nearWater": {
                                        "type": "boolean"
                                    },
                                    "season": {
                                        "enum": [
                                            "spring",
                                            "summer",
                                            "fall",
                                            "winter",
                                            "Spring",
                                            "Summer",
                                            "Fall",
                                            "Winter"
                                        ]
                                    },
                                    "timeOfDay": {
                                        "$ref": "common.schema.json#/$defs/range",
                                        "items": {
                                            "minimum": 600,
                                            "maximum": 2600
                                        }
                                    },
                                    "weather": {
                                        "$ref": "rule.schema.json#/properties/when/properties/weather/items"
                                    },
                                    "stage": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                }
                            },
                            "flee": {
                                "type": "object",
                                "required": [
                                    "do"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                    "radius": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 20
                                    },
                                    "do": {
                                        "enum": [
                                            "swimAway",
                                            "flyOff"
                                        ]
                                    },
                                    "sound": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "relocate": {
                                        "$ref": "#/$defs/relocate"
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        }
    },
    "$defs": {
        "legacyThreat": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "fleeRadius": {
                    "description": "Tiles; a farmer or character this close runs the bird's flee action.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                },
                "runningMultiplier": {
                    "description": "A running farmer counts this many times closer.",
                    "type": "number",
                    "minimum": 1,
                    "maximum": 4
                },
                "relocate": {
                    "$ref": "#/$defs/relocate"
                },
                "alert": {
                    "description": "Land and water-land only. Inside this radius (larger than fleeRadius) a grounded bird freezes on the clip, then resumes after calmMs without a threat in the radius. Registers an observation.",
                    "type": "object",
                    "required": [
                        "radius",
                        "clip"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "radius": {
                            "type": "integer",
                            "minimum": 2,
                            "maximum": 20
                        },
                        "clip": {
                            "type": "string",
                            "minLength": 1
                        },
                        "sound": {
                            "description": "Sound role played when the bird alerts.",
                            "type": "string",
                            "minLength": 1
                        },
                        "calmMs": {
                            "description": "Default 1500.",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 60000
                        }
                    }
                }
            }
        },
        "relocate": {
            "description": "Fly to a free target within maxDistance tiles and away from the threat, at most maxRelocations times. Chance defaults to 1.",
            "type": "object",
            "required": [
                "target"
            ],
            "additionalProperties": false,
            "properties": {
                "target": {
                    "enum": [
                        "otherTree",
                        "ground",
                        "water",
                        "any"
                    ]
                },
                "maxDistance": {
                    "description": "Tiles, default 12.",
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 30
                },
                "maxRelocations": {
                    "description": "Default 1.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                },
                "chance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            }
        }
    }
}