{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://birding.invalid/schemas/reaction.schema.json",
    "title": "Reactions",
    "description": "How a bird reacts to triggers. Missing fields keep the bird type's default (flee radius: land and water-land 4, tree trunk 6). Bush birds default to flee radius 3 and an alert ring of 12 that makes them flee after 3 s.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "threat": {
            "oneOf": [
                {
                    "description": "Shared reactions id (assets/reactions) whose threat to use.",
                    "type": "string",
                    "minLength": 1
                },
                {
                    "$ref": "#/$defs/legacyThreat"
                },
                {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": [
                            "flee"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "if": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "groupHasRole": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "nearWater": {
                                        "type": "boolean"
                                    },
                                    "season": {
                                        "enum": [
                                            "spring",
                                            "summer",
                                            "fall",
                                            "winter",
                                            "Spring",
                                            "Summer",
                                            "Fall",
                                            "Winter"
                                        ]
                                    },
                                    "timeOfDay": {
                                        "$ref": "common.schema.json#/$defs/range",
                                        "items": {
                                            "minimum": 600,
                                            "maximum": 2600
                                        }
                                    },
                                    "weather": {
                                        "oneOf": [
                                            {
                                                "$ref": "rule.schema.json#/properties/when/properties/weather/items"
                                            },
                                            {
                                                "$ref": "rule.schema.json#/properties/when/properties/weather"
                                            }
                                        ]
                                    },
                                    "stage": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                }
                            },
                            "flee": {
                                "type": "object",
                                "required": [
                                    "do"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                    "radius": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 20
                                    },
                                    "do": {
                                        "enum": [
                                            "swimAway",
                                            "flyOff"
                                        ]
                                    },
                                    "sound": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "escape": {
                                        "$ref": "#/$defs/escape"
                                    },
                                    "maxRelocations": {
                                        "$ref": "#/$defs/maxRelocations"
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "cohesion": {
            "description": "Group cohesion preset id (assets/reactions) or inline object, optionally extending a preset.",
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 1
                },
                {
                    "$ref": "#/$defs/cohesion"
                }
            ]
        }
    },
    "$defs": {
        "legacyThreat": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "fleeRadius": {
                    "description": "Tiles; a farmer or character this close runs the bird's flee action.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                },
                "runningMultiplier": {
                    "description": "A running farmer counts this many times closer.",
                    "type": "number",
                    "minimum": 1,
                    "maximum": 4
                },
                "escape": {
                    "$ref": "#/$defs/escape"
                },
                "maxRelocations": {
                    "$ref": "#/$defs/maxRelocations"
                },
                "alert": {
                    "description": "Land and water-land only. Inside this radius (larger than fleeRadius) a grounded bird freezes on the clip, then resumes after calmMs without a threat in the radius. Registers an observation.",
                    "type": "object",
                    "required": [
                        "radius",
                        "clip"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "radius": {
                            "type": "integer",
                            "minimum": 2,
                            "maximum": 20
                        },
                        "clip": {
                            "type": "string",
                            "minLength": 1
                        },
                        "sound": {
                            "description": "Sound role played when the bird alerts.",
                            "type": "string",
                            "minLength": 1
                        },
                        "calmMs": {
                            "description": "Default 1500.",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 60000
                        },
                        "fleeAfterMs": {
                            "description": "Flee after this long of continuous alert. Absent: never.",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 60000
                        }
                    }
                }
            }
        },
        "escape": {
            "description": "Weighted ways to escape a threat. Options with no free spot within maxDistance tiles, away from the threat, are skipped; offscreen always qualifies. With no option left the bird flees.",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "target"
                ],
                "additionalProperties": false,
                "properties": {
                    "target": {
                        "enum": [
                            "ground",
                            "water",
                            "otherTree",
                            "tree",
                            "offscreen"
                        ]
                    },
                    "weight": {
                        "description": "Default 1.",
                        "type": "number",
                        "exclusiveMinimum": 0
                    },
                    "maxDistance": {
                        "description": "Tiles, default 12.",
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 30
                    },
                    "hideForMs": {
                        "description": "Only for target tree: how long the bird stays hidden in the canopy. Default 10000.",
                        "type": "integer",
                        "minimum": 1000,
                        "maximum": 120000
                    }
                }
            }
        },
        "maxRelocations": {
            "description": "Nearby escapes before the bird flees for good. Default 1.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
        },
        "cohesion": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "extends": {
                    "type": "string",
                    "minLength": 1
                },
                "spread": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Chance an informed bird informs each neighbour within linkRadius."
                },
                "linkRadius": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                },
                "delayMs": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5000
                    }
                },
                "sameOutcome": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "rally": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                },
                "fan": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "regroup": {
                    "type": "boolean"
                },
                "rejoinDelayMs": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 60000
                    }
                }
            }
        }
    }
}
