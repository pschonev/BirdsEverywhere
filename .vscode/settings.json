{
    "json.schemas": [
        { "fileMatch": ["Birding/assets/regions.json"], "url": "./schemas/regions.schema.json" },
        { "fileMatch": ["Birding/assets/templates/*.json"], "url": "./schemas/template.schema.json" },
        { "fileMatch": ["Birding/assets/compat/*.json"], "url": "./schemas/compat.schema.json" },
        { "fileMatch": ["Birding/assets/layouts/*.json"], "url": "./schemas/layout.schema.json" },
        { "fileMatch": ["Birding/assets/routines/*.json"], "url": "./schemas/routine.schema.json" },
        { "fileMatch": ["Birding/assets/actions/*.json"], "url": "./schemas/action.schema.json" },
        { "fileMatch": ["Birding/assets/reactions/*.json"], "url": "./schemas/reaction.schema.json" },
        {
            "fileMatch": [
                "Birding/assets/*/*.json",
                "!Birding/assets/templates/*.json",
                "!Birding/assets/compat/*.json",
                "!Birding/assets/layouts/*.json",
                "!Birding/assets/routines/*.json",
                "!Birding/assets/actions/*.json",
                "!Birding/assets/reactions/*.json"
            ],
            "url": "./schemas/bird.schema.json"
        }
    ]
}
